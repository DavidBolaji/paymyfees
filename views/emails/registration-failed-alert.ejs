<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Registration Failed — <%= userEmail %></title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f3f6fb;
            font-family: Manrope, "Segoe UI", Arial, sans-serif;
            color: #292929;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
        }

        .wrapper {
            width: 100%;
            background-color: #f3f6fb;
            padding: 24px 12px;
        }

        .card {
            width: 100%;
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 14px;
            margin: 0 auto;
            padding: 28px 30px;
        }

        h1 {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 800;
            color: #a3122b;
        }

        .subtitle {
            margin: 0 0 20px;
            font-size: 14px;
            color: #6c7480;
        }

        .data {
            width: 100%;
            font-size: 13px;
            line-height: 140%;
            margin-bottom: 20px;
        }

        .data td {
            padding: 10px 8px;
            border-bottom: 1px solid #eef1f6;
            vertical-align: top;
        }

        .data td:first-child {
            width: 130px;
            color: #6c7480;
            font-weight: 700;
            white-space: nowrap;
        }

        .reason {
            background-color: #fdecef;
            color: #a3122b;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        h2 {
            margin: 0 0 8px;
            font-size: 14px;
            font-weight: 800;
            color: #00296b;
        }

        pre {
            background-color: #f7f9fc;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 12px;
            line-height: 150%;
            color: #292929;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-word;
            margin: 0 0 20px;
        }

        .footer {
            margin-top: 10px;
            padding-top: 16px;
            border-top: 1px solid #eef1f6;
            font-size: 12px;
            color: #6c7480;
        }
    </style>
</head>

<body>
    <table role="presentation" width="100%" class="wrapper">
        <tr>
            <td align="center">
                <table role="presentation" class="card" width="600">
                    <tr>
                        <td>
                            <h1>Registration Failed</h1>
                            <p class="subtitle">A new user could not be provisioned and their account was rolled back.</p>

                            <table role="presentation" class="data">
                                <tr>
                                    <td>Name</td>
                                    <td><%= userFullName %></td>
                                </tr>
                                <tr>
                                    <td>Email</td>
                                    <td><%= userEmail %></td>
                                </tr>
                                <tr>
                                    <td>Role</td>
                                    <td><%= role %></td>
                                </tr>
                                <tr>
                                    <td>Occurred</td>
                                    <td><%= occurredAt %></td>
                                </tr>
                            </table>

                            <div class="reason"><%= reason %></div>

                            <% if (payloadJson) { %>
                            <h2>Registration payload</h2>
                            <p class="subtitle">Password and other sensitive fields are redacted.</p>
                            <pre><%= payloadJson %></pre>
                            <% } %>

                            <div class="footer">
                                Automated message from <%= appName %> registration. Full details are in the admin
                                event log under category EMBEDLY.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
