<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Auto-Debit Failures — <%= runDate %></title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f3f6fb;
            font-family: Manrope, "Segoe UI", Arial, sans-serif;
            color: #292929;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
        }

        .wrapper {
            width: 100%;
            background-color: #f3f6fb;
            padding: 24px 12px;
        }

        .card {
            width: 100%;
            max-width: 900px;
            background-color: #ffffff;
            border-radius: 14px;
            margin: 0 auto;
            padding: 28px 30px;
        }

        h1 {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 800;
        }

        h2 {
            margin: 28px 0 10px;
            font-size: 16px;
            font-weight: 800;
            color: #00296b;
        }

        .subtitle {
            margin: 0 0 20px;
            font-size: 14px;
            color: #6c7480;
        }

        .stats {
            width: 100%;
            margin: 0 0 22px;
        }

        .stats td {
            padding: 12px 14px;
            background-color: #f7f9fc;
            border-radius: 10px;
            text-align: center;
            font-size: 13px;
            color: #6c7480;
            font-weight: 600;
        }

        .stats .num {
            display: block;
            font-size: 22px;
            font-weight: 800;
            color: #292929;
            margin-bottom: 2px;
        }

        .data {
            width: 100%;
            font-size: 13px;
            line-height: 140%;
        }

        .data th {
            background-color: #00296b;
            color: #ffffff;
            text-align: left;
            padding: 10px 8px;
            font-weight: 700;
            font-size: 12px;
            white-space: nowrap;
        }

        .data td {
            padding: 10px 8px;
            border-bottom: 1px solid #eef1f6;
            vertical-align: top;
        }

        .data tr:nth-child(even) td {
            background-color: #fafbfd;
        }

        .num-cell {
            text-align: right;
            white-space: nowrap;
        }

        .tag {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .tag-funds {
            background-color: #fff4ed;
            color: #b23c17;
        }

        .tag-account {
            background-color: #fdecef;
            color: #a3122b;
        }

        .tag-transfer {
            background-color: #f3ecfd;
            color: #5b21b6;
        }

        .tag-error {
            background-color: #eef1f6;
            color: #3f4652;
        }

        .empty {
            font-size: 14px;
            color: #6c7480;
            padding: 8px 0;
        }

        .footer {
            margin-top: 26px;
            padding-top: 16px;
            border-top: 1px solid #eef1f6;
            font-size: 12px;
            color: #6c7480;
        }
    </style>
</head>

<body>
    <table role="presentation" width="100%" class="wrapper">
        <tr>
            <td align="center">
                <table role="presentation" class="card" width="900">
                    <tr>
                        <td>
                            <h1>Auto-Debit Failures &mdash; <%= runDate %></h1>
                            <p class="subtitle">
                                <%= failures.length %> user<%= failures.length === 1 ? '' : 's' %> could not be
                                debited<% if (summary && summary.dryRun) { %> &middot; <strong>DRY RUN</strong><% } %>
                            </p>

                            <% if (summary) { %>
                            <table role="presentation" class="stats">
                                <tr>
                                    <td><span class="num"><%= summary.attempted %></span>Attempted</td>
                                    <td width="8"></td>
                                    <td><span class="num"><%= summary.succeeded %></span>Succeeded</td>
                                    <td width="8"></td>
                                    <td><span class="num"><%= summary.failed %></span>Failed</td>
                                    <td width="8"></td>
                                    <td><span class="num"><%= summary.skipped %></span>Skipped</td>
                                </tr>
                            </table>
                            <% } %>

                            <% if (failures && failures.length > 0) { %>
                            <h2>Failed debits</h2>
                            <table role="presentation" class="data">
                                <tr>
                                    <th>Name</th>
                                    <th>Contact</th>
                                    <th>Loan / School</th>
                                    <th>Inst.</th>
                                    <th class="num-cell">Due</th>
                                    <th class="num-cell">Balance</th>
                                    <th class="num-cell">Shortfall</th>
                                    <th class="num-cell">Overdue</th>
                                    <th>Reason</th>
                                </tr>
                                <% failures.forEach(function (f) { %>
                                <tr>
                                    <td><%= f.fullName %></td>
                                    <td>
                                        <%= f.email %><% if (f.phone) { %><br><%= f.phone %><% } %>
                                    </td>
                                    <td>
                                        <strong><%= f.loanNumber %></strong><br><%= f.schoolName %>
                                    </td>
                                    <td>#<%= f.installmentNumber %></td>
                                    <td class="num-cell"><%= f.amountDue %></td>
                                    <td class="num-cell"><%= f.walletBalance %></td>
                                    <td class="num-cell"><strong><%= f.shortfall %></strong></td>
                                    <td class="num-cell"><%= f.daysOverdue %>d</td>
                                    <td>
                                        <% var cls = f.status === 'INSUFFICIENT_FUNDS' ? 'tag-funds'
                                            : f.status === 'NO_VIRTUAL_ACCOUNT' ? 'tag-account'
                                            : f.status === 'TRANSFER_FAILED' ? 'tag-transfer' : 'tag-error'; %>
                                        <span class="tag <%= cls %>"><%= f.status.replace(/_/g, ' ') %></span>
                                    </td>
                                </tr>
                                <% }); %>
                            </table>
                            <% } %>

                            <% if (stuck && stuck.length > 0) { %>
                            <h2>Payments needing manual attention</h2>
                            <p class="subtitle">Transfers that could not be confirmed automatically. A
                                &ldquo;rolled back&rdquo; row means the user's wallet was refunded.</p>
                            <table role="presentation" class="data">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Reference</th>
                                    <th class="num-cell">Amount</th>
                                    <th class="num-cell">Stuck for</th>
                                    <th>Resolution</th>
                                </tr>
                                <% stuck.forEach(function (s) { %>
                                <tr>
                                    <td><%= s.fullName %></td>
                                    <td><%= s.email %></td>
                                    <td><%= s.transactionReference %></td>
                                    <td class="num-cell"><%= s.amount %></td>
                                    <td class="num-cell"><%= s.stuckSinceHours %>h</td>
                                    <td>
                                        <span class="tag <%= s.resolution === 'gave_up' ? 'tag-account' : 'tag-error' %>">
                                            <%= s.resolution.replace(/_/g, ' ') %>
                                        </span>
                                    </td>
                                </tr>
                                <% }); %>
                            </table>
                            <% } %>

                            <% if ((!failures || failures.length === 0) && (!stuck || stuck.length === 0)) { %>
                            <p class="empty">No failures in this run.</p>
                            <% } %>

                            <div class="footer">
                                Automated message from the <%= appName %> auto-debit job. Full history is in the
                                admin logs.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
